# Copy this file to .env.local if you want to use real OpenAI-generated reports.
# TestMind AI works fully offline without this file — see README.md.
# Never commit a real .env.local — it is already excluded via .gitignore (.env*).

# Optional. When unset, TestMind AI automatically falls back to its local mock
# AI provider, so the app is fully usable without an OpenAI account.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini
